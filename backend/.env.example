PORT=3001
# PostgreSQL connection string (Neon: Dashboard -> Connection string). See docs/POSTGRES_SETUP.md
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Direct (non -pooler) string, used only for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# true = talk to Neon over WebSocket (port 443) instead of TCP 5432. Only for networks
# that block 5432 (e.g. campus Wi-Fi); leave false on the server.
PG_OVER_WEBSOCKET=false
# Required. Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Changing it logs everyone out — do that once after deploying these fixes.
JWT_SECRET=
ML_SERVICE_URL=http://127.0.0.1:5005
NODE_ENV=production

# QR token window: each code is valid for its own 4 s window, plus this much
# after it rotates to absorb network delay. 0 = strictly 4 s.
TOKEN_GRACE_MS=1500
# Line-of-Sight PIN: grace after the PIN rotates, time to tap it, attempts allowed.
PIN_GRACE_MS=2000
PIN_WINDOW_MS=15000
MAX_PIN_ATTEMPTS=2

# Let a logged-in student enroll their own face on first scan (saved as FLAGGED for review).
ALLOW_SELF_ENROLLMENT=false

# Faculty sign-up is invite-only. Empty = sign-up disabled.
FACULTY_INVITE_CODE=

# Only needed if another origin calls the API directly (comma-separated).
CORS_ORIGINS=

# Development only: seed a demo faculty/classroom/courses on an empty database.
SEED_DEMO=false
SEED_FACULTY_PASSWORD=

# Only for the one-time copy from MongoDB Atlas (npm run migrate:from-mongo)
MONGODB_URI=
